# ==============================================================================
# AI Job Finder & Autonomous Auto-Applicant Configuration
# ==============================================================================
# Copy this file to .env and configure your details before running.

# ─── Apify API Token (LinkedIn & Remote Board Scrapers) ────────────────────────
# Get your token from https://apify.com/
APIFY_API_TOKEN=your_apify_api_token_here

# ─── Kilo Code / LLM Gateway ──────────────────────────────────────────────────
# Free OpenAI-compatible LLM gateway for scoring jobs and tailoring pitches
KILO_API_KEY=your_kilo_api_key_here
KILO_BASE_URL=https://api.kilo.ai/api/gateway/v1
KILO_MODEL=kilo-auto/free

# ─── Candidate Profile & Contact Information ──────────────────────────────────
CANDIDATE_NAME=Your Full Name
CANDIDATE_EMAIL=your_email@example.com
CANDIDATE_PHONE=+1 234 567 8900
CANDIDATE_PORTFOLIO=https://yourportfolio.com
CANDIDATE_GITHUB=https://github.com/yourusername
RESUME_FILE=Resume.pdf

# ─── Gmail SMTP Credentials for Sending Outreach ──────────────────────────────
# Generate an App Password in Google Account -> Security -> 2-Step Verification
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password

# Optional Google OAuth Token JSON path
GMAIL_TOKEN_JSON=gmail_token.json

# ─── Job Search Filters & Application Rate Limits ─────────────────────────────
TARGET_ROLES=Full Stack Developer, AI Engineer, Python Developer, Flutter Developer
DAILY_JOB_LIMIT=50
# Set DRY_RUN=False to actively dispatch real emails, True to simulate and preview
DRY_RUN=True

# ─── Telegram Bot Token for Remote Control & Notifications ────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
